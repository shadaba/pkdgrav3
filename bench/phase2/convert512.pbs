#!/bin/bash -l
# Phase 2: convert and verify the 512^3 HDF5 snapshots in bench/sim512 with 64 threads (local SSD output).
#PBS -N p2_conv512
#PBS -q workq
#PBS -l select=1:ncpus=64:mem=96gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /storage/shadab/pkdgrav3_io/bench/logs/p2_conv512.out
set -u
J=${PBS_JOBID%%.*}
W=/storage/shadab/pkdgrav3_io
exec > $W/bench/logs/p2_conv512.$J.log 2>&1
source $W/pkdgrav3/bench/phase0/env_pawna.sh
L=/var/tmp/shadab_p2c_$J; mkdir -p $L; trap 'rm -rf $L' EXIT
KEEP=$W/bench/p2_pkc; mkdir -p $KEEP
cd $W/bench/sim512
for s in snap.000??; do
  echo "== $s: 9 subsamples, 64 threads"
  $W/build_snapcomp/pkc_convert --threads 64 --verify $s $L/$s
  echo "== $s: single file"
  $W/build_snapcomp/pkc_convert --threads 64 --percents 100 --verify $s $L/${s}_single
  echo "== $s: single file, finer accuracy (0.38 kpc/h, 1 km/s)"
  $W/build_snapcomp/pkc_convert --threads 64 --percents 100 --dx 0.381 --dv 1 $s $L/${s}_fine
  ls -la $s; rm -f $L/${s}_single.* $L/${s}_fine.*
done
last=$(ls snap.000?? | tail -1); cp $L/$last.s*.pkc $KEEP/ && echo "kept $last subsample files in $KEEP"
echo "done $(date -Is)"
