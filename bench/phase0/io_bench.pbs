#!/bin/bash
# Phase 0: streaming-write ceiling for NFS (/storage) and home (/user), bs=4M, 1/4/16/64 streams.
# Write-only, each stream writes its own file, fdatasync before close (data reaches the server, not
# just page cache). Total data per (target, stream-count) = TOTAL_GB, so per-stream size = TOTAL_GB/N.
# Uses fio (random buffers) if present on the node, otherwise parallel dd fed from a 4 GB
# /dev/urandom file in /dev/shm (incompressible). Files are deleted after each test.
#PBS -N p0_io
#PBS -q workq
#PBS -l select=1:ncpus=64:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /storage/shadab/pkdgrav3_io/bench/logs/p0_io.out
set -u
exec > /storage/shadab/pkdgrav3_io/bench/logs/p0_io.${PBS_JOBID%%.*}.log 2>&1   # PBS -o copy-back is unreliable here
TOTAL_GB=${TOTAL_GB:-64}              # per test; 8 tests total -> ~512 GB written, deleted as we go
STREAMS=${STREAMS:-"1 4 16 64"}
TARGETS=${TARGETS:-"/storage/shadab/pkdgrav3_io/bench/io_tmp /user/shadab/pkdgrav3_io_bench_tmp"}
echo "host: $(hostname)  date: $(date -Is)  PBS_JOBID=${PBS_JOBID:-}  TOTAL_GB=$TOTAL_GB"
nfsstat -m 2>&1
FIO=$(command -v fio || true); echo "fio: ${FIO:-not found, using dd}"
RAND=/dev/shm/p0rand_$$; RAND_MB=4096       # incompressible source for dd (server may compress zeros)
[ -z "$FIO" ] && head -c ${RAND_MB}M /dev/urandom > $RAND
CUR=""   # target being written; removed if PBS kills the job at walltime (SIGTERM)
trap 'rm -f $RAND; [ -n "$CUR" ] && rm -rf "$CUR"' EXIT
trap 'echo "killed (SIGTERM), cleaning $CUR"; kill $(jobs -p) 2>/dev/null; exit 143' TERM
printf "%-45s %8s %10s %10s %10s\n" target streams GB_total seconds MB_per_s
for T in $TARGETS; do
  mkdir -p "$T" || { echo "cannot create $T"; continue; }
  CUR=$T
  for N in $STREAMS; do
    MB_PER=$(( TOTAL_GB * 1024 / N )); CNT=$(( MB_PER / 4 ))
    sync; t0=$(date +%s.%N)
    if [ -n "$FIO" ]; then
      fio --name=w --directory="$T" --rw=write --bs=4M --size=${MB_PER}M --numjobs=$N \
          --ioengine=psync --end_fsync=1 --refill_buffers --direct=0 --group_reporting --output-format=terse \
          > "$T/fio_$N.terse" 2>&1
    else
      for i in $(seq 1 $N); do
        { while cat $RAND; do :; done; } 2>/dev/null | dd of="$T/s$i" bs=4M count=$CNT iflag=fullblock conv=fdatasync status=none &
      done; wait
    fi
    t1=$(date +%s.%N)
    awk -v t="$T" -v n=$N -v g=$TOTAL_GB -v a=$t0 -v b=$t1 \
      'BEGIN{s=b-a; printf "%-45s %8d %10d %10.1f %10.0f\n", t, n, g, s, g*1024/s}'
    rm -f "$T"/s* "$T"/w.* 2>/dev/null
  done
  rm -rf "$T"; CUR=""
done
echo "done $(date -Is)"
